        try:
            jumlah_hari = int(args[0])  # Coba parse sebagai jumlah hari
            if jumlah_hari <= 0:
                raise ValueError("Jumlah hari harus lebih dari 0")
        except ValueError:
            try:
                datetime.strptime(args[0], '%Y-%m-%d')  # Coba parse sebagai tanggal
