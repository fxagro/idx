from fastapi import APIRouter, Depends, HTTPException, status, Request
from fastapi.security import HTTPBearer, HTTPAuthorizationCredentials
from sqlalchemy.orm import Session
from pydantic import BaseModel, EmailStr
from typing import Optional
import datetime

from ..database import get_local_db
from ..models import User
from ..auth_utils import verify_password, get_password_hash, create_access_token, decode_access_token

router = APIRouter(prefix="/auth", tags=["Authentication"])
security = HTTPBearer()

# Pydantic schemas
class LoginRequest(BaseModel):
    email: EmailStr
    password: str

class RegisterRequest(BaseModel):
    email: EmailStr
    password: str

class UpdateProfileRequest(BaseModel):
    avatar: Optional[str] = None
    # Add other profile fields if needed

# Dependency to get current user from JWT token
async def get_current_user(
    credentials: HTTPAuthorizationCredentials = Depends(security), 
    db: Session = Depends(get_local_db)
) -> User:
    token = credentials.credentials
    payload = decode_access_token(token)
    if not payload:
        raise HTTPException(
            status_code=status.HTTP_401_UNAUTHORIZED,
            detail="Invalid authentication credentials"
        )
    user_id = payload.get("id")
    user = db.query(User).filter(User.id == user_id).first()
    if not user:
        raise HTTPException(
            status_code=status.HTTP_401_UNAUTHORIZED,
            detail="User not found"
        )
    return user

@router.post("/login")
def login(payload: LoginRequest, db: Session = Depends(get_local_db)):
    user = db.query(User).filter(User.email == payload.email.lower().strip()).first()
    if not user:
        return {"success": False, "message": "Invalid credentials"}
        
    if not verify_password(payload.password, user.password):
        return {"success": False, "message": "Invalid credentials"}
        
    # Update last login
    user.last_login = datetime.datetime.utcnow()
    user.auth_method = "password"
    db.commit()
    
    token = create_access_token(user.id, user.email, user.role)
    
    return {
        "success": True,
        "token": token,
        "message": "Login successful"
    }

@router.post("/register")
def register(payload: RegisterRequest, db: Session = Depends(get_local_db)):
    email_sanitized = payload.email.lower().strip()
    
    # Check if user already exists
    existing_user = db.query(User).filter(User.email == email_sanitized).first()
    if existing_user:
        raise HTTPException(
            status_code=status.HTTP_409_CONFLICT,
            detail="User with this email already exists"
        )
        
    # Create new user
    hashed_pwd = get_password_hash(payload.password)
    new_user = User(
        email=email_sanitized,
        password=hashed_pwd,
        role="user",
        status="active"
    )
    db.add(new_user)
    db.commit()
    db.refresh(new_user)
    
    token = create_access_token(new_user.id, new_user.email, new_user.role)
    
    return {
        "success": True,
        "message": "Registration successful",
        "data": {
            "token": token,
            "user": {
                "id": new_user.id,
                "email": new_user.email,
                "role": new_user.role
            }
        }
    }

@router.post("/refresh")
def refresh(request: Request):
    # Mock refresh token endpoint
    auth_header = request.headers.get("Authorization")
    if not auth_header or not auth_header.startswith("Bearer "):
        raise HTTPException(status_code=401, detail="Unauthorized")
        
    token = auth_header.split(" ")[1]
    payload = decode_access_token(token)
    if not payload:
        raise HTTPException(status_code=401, detail="Invalid token")
        
    # Re-create token
    new_token = create_access_token(payload["id"], payload["email"], payload["role"])
    return {
        "success": True,
        "token": new_token,
        "message": "Token refreshed successfully"
    }

@router.post("/revoke")
def revoke():
    return {"success": True, "message": "Token revoked successfully"}

@router.post("/update-profile")
def update_profile(payload: UpdateProfileRequest, current_user: User = Depends(get_current_user), db: Session = Depends(get_local_db)):
    if payload.avatar is not None:
        current_user.avatar = payload.avatar
    db.commit()
    return {"success": True, "message": "Profile updated successfully"}

# Mount GET /api/me here as well for simplicity
@router.get("/me")
def get_me(current_user: User = Depends(get_current_user)):
    return {
        "success": True,
        "data": {
            "id": current_user.id,
            "email": current_user.email,
            "role": current_user.role,
            "avatar": current_user.avatar,
            "virtual_saldo": float(current_user.virtual_saldo) if current_user.virtual_saldo else 0.0,
            "ai_quota": current_user.ai_quota,
            "ai_usage": current_user.ai_usage,
            "ai_limit": current_user.ai_limit,
            "subscription_expiry": str(current_user.subscription_expiry) if current_user.subscription_expiry else None
        }
    }
